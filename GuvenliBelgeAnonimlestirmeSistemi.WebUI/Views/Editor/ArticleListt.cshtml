@model List<ArticleViewModel>
@{
    ViewData["Title"] = "ArticleListt";
    Layout = "~/Views/Shared/_EditorLayout.cshtml";
}
<div class="outer-container">
    <div class="inner-container">
        <h3 class="text-center mb-4 fw-bold text" style="color:#1c2331;">
            <i class="fas fa-file-alt"></i> Makale Listesi
        </h3>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table text-center" style=" background-color: #1c2331; color: white;">
                    <tr>
                        <th>Yüklenme Tarihi</th>
                        <th>Takip No</th>
                        <th>E-Posta</th>
                        <th>Durum</th>
                        <th>Son İşlem</th>
                        <th>Orijinal PDF</th>
                        <th>Anonim PDF</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var makale in Model)
                    {
                        <tr>
                            <td>@makale.MakaleYuklemeTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                            <td><span class="fw-semibold ">@makale.TakipNo</span></td>
                            <td>@makale.YazarEPosta</td>
                            <td>
                                @{
                                    string badgeStyle;
                                    string badgeText;

                                    switch (makale.MakaleDurumu)
                                    {
                                        case ArticleStatus.MakaleBeklemede:
                                            badgeStyle = "background-color: #ffecb3; color: #856404;";
                                            badgeText = "Makale Beklemede";
                                            break;
                                        case ArticleStatus.RevizeEdildi:
                                            badgeStyle = "background-color: #f8d7da; color: #721c24;";
                                            badgeText = "Revize Edildi";
                                            break;
                                        case ArticleStatus.EditorIncelemede:
                                            badgeStyle = "background-color: #cce5ff; color: #004085;";
                                            badgeText = "Editör İncelemede";
                                            break;
                                        case ArticleStatus.HakemeAtandi:
                                            badgeStyle = "background-color: #d1ecf1; color: #0c5460;";
                                            badgeText = "Hakeme Atandı";
                                            break;
                                        case ArticleStatus.HakemDegerlendirilmesinde:
                                            badgeStyle = "background-color: #e2e3e5; color: #383d41;";
                                            badgeText = "Hakem Değerlendirmesinde";
                                            break;
                                        case ArticleStatus.HakemDegerlendirdi:
                                            badgeStyle = "background-color: #d4edda; color: #155724;";
                                            badgeText = "Hakem Değerlendirdi";
                                            break;
                                        case ArticleStatus.EditorSonuclandirmada:
                                            badgeStyle = "background-color: #b8daff; color: #004085;";
                                            badgeText = "Editör Sonuçlandırmada";
                                            break;
                                        case ArticleStatus.MakaleSonuclandirildi:
                                            badgeStyle = "background-color: #c3e6cb; color: #155724;";
                                            badgeText = "Makale Sonuçlandırıldı";
                                            break;
                                        case ArticleStatus.MakaleSonucuYazaraIletildi:
                                            badgeStyle = "background-color: #c3e6cb; color: #155724;";
                                            badgeText = "Sonuç Yazara İletildi";
                                            break;
                                        default:
                                            badgeStyle = "background-color: #fefefe; color: #818182;";
                                            badgeText = "Bilinmeyen Durum";
                                            break;
                                    }
                                }

                                <span class="badge" style="@badgeStyle">
                                    @badgeText
                                </span>
                            </td>
                            <td>
                                @if (makale.EnSonYapilanIsleminTarihi.HasValue)
                                {
                                    @makale.EnSonYapilanIsleminTarihi.Value.ToString("dd.MM.yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">Yok</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(makale.PdfFilePath))
                                {
                                    <a href="@makale.PdfFilePath" target="_blank" class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-file-pdf me-1"></i> PDF
                                    </a>
                                }
                                else { <span class="text-muted">Yok</span> }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(makale.AnonimPdfFilePath))
                                {
                                    <a href="@makale.AnonimPdfFilePath" target="_blank" class="btn btn-outline-success btn-sm">
                                        <i class="fas fa-user-secret me-1"></i> PDF
                                    </a>
                                }
                                else { <span class="text-muted">Yok</span> }
                            </td>
                            <td>
                                <a href="@Url.Action("ArticleIslem", "Editor", new { id = makale.MakaleId })" class="btn btn btn-sm" style="background-color:#5e6785; color:white;">
                                   <i class="fa-solid fa-tasks"></i> İşlemler
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .outer-container {
        background: white;
    }

    .inner-container {
        background-color: transparent;
        box-shadow: none;
        border-radius: 0;
        padding: 0;
    }

    .table {
        border-radius: 10px !important;
        overflow: hidden;
    }

    .table th,
    .table td {
        text-align: center;
        vertical-align: middle;
    }

    .table th {
        font-size: 0.9rem;
    }

    .table td {
        font-size: 0.88rem;
    }

    .btn-sm i {
        margin-right: 4px;
    }

    .badge {
        padding: 6px 12px;
        font-size: 0.75rem;
    }

    .fw-semibold {
        font-weight: 600;
    }
</style>

