
@model List<ArticleViewModel>

@{
    ViewData["Title"] = "Makale Listesi";
    Layout = "~/Views/Shared/_EditorLayout.cshtml";
}
<h3 class="text-center">Makale Listesi</h3>
    <div class="container-table">
        
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th class="small">Yüklenme Tarihi</th>
                        <th class="small">E-Posta</th>
                        <th class="small">Durum</th>
                        <th class="small">Alan Atama</th>
                        <th class="small">Son İşlem Tarihi</th>
                        <th class="small">Orijinal PDF</th>
                        <th class="small">Anonim PDF</th>
                        <th class="small">Anonim İşlemleri</th>
                        <th class="small">Hakem İşlemleri</th>
                        <th class="small">Sonuç Gönder</th>
                    </tr>
                </thead>
                <tbody id="articleTableBody">
                    @foreach (var makale in Model)
                    {
                        <tr data-date="@makale.MakaleYuklemeTarihi.ToString("dd/MM/yyyy HH:mm")" data-status="@((int)makale.MakaleDurumu)">
                            <td class="small">@makale.MakaleYuklemeTarihi.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="small">@makale.YazarEPosta</td>
                            <td class="small">
                                <span class="badge bg-info">@makale.MakaleDurumu</span>
                            </td>
                            <td class="small">
                                <small class="text-muted">
                                       @string.Join(", ", makale.IlgiAlanlari?.Where(x => !string.IsNullOrWhiteSpace(x)) ?? new List<string>())
                                </small>
                            </td>
                            <td class="small">
                                @if (makale.EnSonYapilanIsleminTarihi.HasValue)
                                {
                                    @makale.EnSonYapilanIsleminTarihi.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">Yok</span>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(makale.PdfFilePath))
                                {
                                    <a href="@makale.PdfFilePath" target="_blank" class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-file-pdf"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Yok</span>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(makale.AnonimPdfFilePath))
                                {
                                    <a href="@makale.AnonimPdfFilePath" target="_blank" class="btn btn-outline-success btn-sm">
                                        <i class="fas fa-user-secret"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Yok</span>
                                }
                            </td>
                            <td class="small">
                                <a href="@Url.Action("AnonymizedArticle", "Editor", new { id = makale.MakaleId })" class="btn btn-warning btn-sm">
                                       <i class="fas fa-shield-alt"></i> Uygula
                               </a>
                            </td>
                            <td class="small">
                                <form asp-controller="Article" asp-action="AssignReviewer" method="post" class="d-flex align-items-center gap-2 w-100">
                                    <input type="hidden" name="ArticleId" value="@makale.MakaleId" />
                                    <select name="ReviewerId" class="form-select form-select-sm flex-grow-1 px-3">
                                    <option value="">Hakem Seç</option>
                                    @if (makale.OnerilenHakemler != null && makale.OnerilenHakemler.Any())
                                    {
                                        foreach (var hakem in makale.OnerilenHakemler)
                                        {
                                            if (makale.ReviewerId!=null && makale.ReviewerId==hakem.ReviewerId)
                                            {
                                                <option value="@hakem.ReviewerId" selected>@hakem.EPosta</option>
                                            }
                                            else
                                            {
                                                <option value="@hakem.ReviewerId">@hakem.EPosta</option>
                                            }
                                        }
                                    }
                                    else
                                    {
                                          <option disabled>Önerilen hakem yok</option>
                                    }
                                    </select>
                                    <button type="submit" class="btn btn-success btn-sm" style="width: 20px; height: 40px; padding: 2px;">
                                        <i class="fa-solid fa-pen-fancy"></i> Ata
                                    </button>
                                </form>
                            </td>

                           
                            <td class="small">
                                <button class="btn btn-primary btn-sm sonucGonder"
                                        data-article-id="@makale.MakaleId"
                                @(makale.MakaleDurumu == ArticleStatus.MakaleSonuclandirildi ? "" : "disabled")>
                                    <i class="fas fa-paper-plane"></i> Gönder
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
     
    </div>

    <style>
    .table th,
    .table td {
        text-align: center !important;
        vertical-align: middle !important;
    }
    .container-table {
        width: 100% !important;
        max-width: 1500px !important; 
        padding: 5px !important;
        margin: 0 auto !important; 
        background: #fff;
        border-radius: 8px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        overflow-x: hidden !important; 
    }

    .table-responsive {
        width: 100%;
        max-width: 100%;
        overflow-x: auto !important; 
    }

    .table {
        width: 100% !important;
        margin: 0 !important;
        border-collapse: collapse;
        table-layout: fixed !important; 
    }

    html, body {
        width: 100vw !important;
        overflow-x: hidden !important; 
    }

    .table td .btn {
        width: 100% !important; 
        max-width: 100% !important;
        display: block !important; 
        text-align: center; 
        padding: 8px 10px !important; 
        box-sizing: border-box; 
    }

    th:nth-child(1), td:nth-child(1), th:nth-child(5), td:nth-child(5), th:nth-child(7), td:nth-child(7) {
        width: 100px !important; 
        text-align: center;
    }

   
    th:nth-child(6), td:nth-child(6) {
        width: 80px !important; 
        text-align: center;
    }

    th:nth-child(10), td:nth-child(10), th:nth-child(3), td:nth-child(3) {
        width: 120px !important;
        text-align: center;
    }

    th:nth-child(8), td:nth-child(8) {
        width: 130px !important;
        text-align: center;
    }
    </style>
