
@{
    ViewData["Title"] = "ArticleUpload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center">Makale Yükle</h2>
    <p class="text-center">Lütfen geçerli bir e-posta adresi girerek akademik makalenizi yükleyin.</p>

    <form method="post" enctype="multipart/form-data" asp-controller="Article" asp-action="ArticleUpload">
        <div class="mb-3">
            <label for="email" class="form-label">E-Posta Adresi:</label>
            <input type="email" class="form-control" id="email" name="email" value="@ViewBag.Email" required>
            @if (ViewBag.EmailError != null)
            {
                <span class="text-danger">@ViewBag.EmailError</span>
            }
        </div>
        <div class="mb-3">
            <label for="makale" class="form-label">PDF Dosyanız:</label>
            <input type="file" class="form-control" id="makale" name="makale" accept=".pdf" required onchange="showFileIcon(event)">
            @if (ViewBag.PdfError != null)
            {
                <span class="text-danger">@ViewBag.PdfError</span>
            }
        </div>

        <div id="filePreviewContainer" class="mt-3 d-none text-center">
            <a id="fileDownloadLink" href="#" download>
                <img id="fileIcon" src="/images/pdf.png" alt="PDF Icon" width="80">
                <p id="fileName" class="mt-2"></p>
            </a>

            <div class="mt-2">
                <button type="button" class="btn btn-primary me-2" onclick="editFile()">Düzenle</button>
                <button type="button" class="btn btn-danger" onclick="deleteFile()">Sil</button>
            </div>
        </div>

        <button type="submit" class="btn btn-success mt-3">Makale Yükle</button>
    </form>
</div>
<script>

    function showFileIcon(event) {
        var file = event.target.files[0];
        if (file && file.type === "application/pdf") {
            var fileURL = URL.createObjectURL(file);
            document.getElementById("fileDownloadLink").href = fileURL; 
            document.getElementById("fileIcon").src = "/images/pdf.png"; 
            document.getElementById("fileName").innerText = file.name; 
            document.getElementById("filePreviewContainer").classList.remove("d-none");
        }
    }

    function editFile() {
        document.getElementById("makale").click(); 
    }

    function deleteFile() {
        document.getElementById("filePreviewContainer").classList.add("d-none");
        document.getElementById("makale").value = ""; 
    }

    
</script>
